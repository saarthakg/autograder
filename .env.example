# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Optional tuning knobs (leases, simulator, timeouts) and their defaults are in apps/server/src/AppConfig.ts.

# --- Model provider (OpenRouter only) ---
# Needed for real grading, rubric drafting, evals and the canary; simulated load-test assignments run without it.
OPENROUTER_API_KEY=
# OpenAI-compatible base URL for model calls.
MODEL_BASE_URL=https://openrouter.ai/api/v1
# Grading model, chosen by the eval (D-19).
GRADING_MODEL=openai/gpt-6-luna
# Fallback models OpenRouter tries in order if the grading model fails (D-30).
GRADING_FALLBACK_MODELS=openai/gpt-6.1-sol
# Providers tried first, in order, for the grading model (OpenRouter provider.order); others follow.
GRADING_PROVIDER_ORDER=openai,azure
# Text model that drafts rubrics, once per saved problem (D-08).
RUBRIC_MODEL=openai/gpt-6.1-terra

# --- Spend and concurrency guards ---
# Refuse model-spending jobs once OpenRouter key credit would drop below this (USD).
BUDGET_FLOOR_USD=5
# Concurrent model calls per server process (D-32).
MODEL_CONCURRENCY=128
# Cap on in-flight model calls across all instances, enforced when a job is claimed (D-12).
MODEL_MAX_IN_FLIGHT=128

# --- Database (local docker compose in dev; Neon in production) ---
# Pooled connection the app uses (PgBouncer transaction mode on Neon).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autograder
# Direct connection, used only by migrations.
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/autograder

# --- Server ---
# HTTP port for the API, web app and worker process.
PORT=3000
# Bearer token for /api/admin/* and load-test runs. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token
