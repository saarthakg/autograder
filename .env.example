# Copy to .env and fill in. .env is gitignored; never commit a real key.

# --- Model provider (OpenRouter only) ---
# Required for real grading, rubric generation, evals and canary runs.
OPENROUTER_API_KEY=
# OpenAI-compatible base URL. Point at fake-llm for load tests,
# e.g. http://localhost:8787/v1 — the only prod/loadtest difference.
MODEL_BASE_URL=https://openrouter.ai/api/v1
# Grading model id; chosen by the eval (see DECISIONS.md).
GRADING_MODEL=
# Rubric-generation model id (text-only, runs once per problem).
RUBRIC_MODEL=

# --- Spend guards ---
# Refuse model-spending jobs if OpenRouter key credit would drop below this.
BUDGET_FLOOR_USD=5
# Max concurrent in-flight model calls per worker process (local Semaphore).
MODEL_CONCURRENCY=32
# Global cap across all instances, enforced in the claim query (D-12).
MODEL_MAX_IN_FLIGHT=64

# --- Database (Neon: two separate projects, D-20 A1) ---
# Pooled (PgBouncer, transaction mode) for the app; direct for migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autograder
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/autograder
LOADTEST_DATABASE_URL=
LOADTEST_DATABASE_URL_DIRECT=

# --- Server ---
PORT=3000
# api | worker | all  (one image; Cloud Run runs api and worker as separate services)
ROLE=all
# Shared bearer token for /internal/* (wake, admin). Generate with: openssl rand -hex 32
INTERNAL_TOKEN=dev-internal-token
# Where the API sends wake-ups after enqueueing a job (D-27). Empty = same process.
WORKER_WAKE_URL=
# Public URL used when building teacher/student/share links.
PUBLIC_BASE_URL=http://localhost:3000
