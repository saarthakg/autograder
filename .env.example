# Copy to .env and fill in. .env is gitignored; never commit a real key.

# --- Model provider (OpenRouter only) ---
# Required for real grading, rubric generation, evals and canary runs.
OPENROUTER_API_KEY=
# OpenAI-compatible base URL (OpenRouter). Simulated load-test assignments
# never call it; they use the in-process simulator (D-28).
MODEL_BASE_URL=https://openrouter.ai/api/v1
# Grading model, chosen by the eval (D-19), and OpenRouter fallbacks tried in order (D-30).
GRADING_MODEL=openai/gpt-6-luna
GRADING_FALLBACK_MODELS=openai/gpt-6.1-sol
# Providers tried first, in order, for each model (OpenRouter provider.order); others follow.
GRADING_PROVIDER_ORDER=openai,azure
# Rubric-generation model id (text-only, runs once per problem).
RUBRIC_MODEL=openai/gpt-6.1-terra

# --- Spend guards ---
# Refuse model-spending jobs if OpenRouter key credit would drop below this.
BUDGET_FLOOR_USD=5
# Max concurrent in-flight model calls per worker process (local Semaphore).
MODEL_CONCURRENCY=128
# Global cap across all instances, enforced in the claim query (D-12).
MODEL_MAX_IN_FLIGHT=128

# --- Database (Neon autograder-prod in deploys; local docker compose in dev) ---
# Pooled (PgBouncer, transaction mode) for the app; direct for migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autograder
DATABASE_URL_DIRECT=postgres://postgres:postgres@localhost:5432/autograder

# --- Server ---
PORT=3000
# Operator token for /api/admin/* and load-test runs (D-28). Generate: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token
# Public URL used when building teacher/student/share links.
PUBLIC_BASE_URL=http://localhost:3000
