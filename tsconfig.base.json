{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    // Bun runs TypeScript directly and Vite bundles the web app, so tsc only typechecks.
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noErrorTruncation": true,
    "types": [],
    "plugins": [
      {
        "name": "@effect/language-service",
        // effect/http-api and effect/sql are marked unstable in 4.1.x; the Effect repo
        // turns this rule off for the same reason. Suggestions stay editor-only.
        "diagnosticSeverity": { "unstableApiUsage": "off" },
        "includeSuggestionsInTsc": false
      }
    ]
  }
}
