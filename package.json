{
  "name": "autograder",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "evals"
  ],
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "typecheck": "bun run --filter '@autograder/*' typecheck",
    "test": "bun run --filter @autograder/server --filter @autograder/evals test",
    "build": "bun run --filter @autograder/web build",
    "migrate": "bun run --filter @autograder/server migrate",
    "dev": "bun run --filter @autograder/server dev",
    "eval": "bun --env-file=.env evals/src/run.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "typescript": "7.0.2"
  }
}
