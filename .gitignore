# --- Secrets: only .env.example is committed ---
.env
.env.*
!.env.example

# --- Private local files: never committed ---
.context/
CLAUDE.md
# Local reference clones of dependency source, for API lookups
.repos/

# --- Dependencies and build output ---
node_modules/
dist/
*.tsbuildinfo
.vite/

# --- Load test: per-run output stays local ---
# Only the curated reports that LOADTEST.md links to are committed (git add -f).
loadtest/reports/*
loadtest/.runs/

# --- Eval: raw per-run results stay local ---
# Each run's summary.md and compact calibration.json are committed.
evals/.cache/
evals/results/*/results.json

# --- e2e: local deps, per-run workspace records, Playwright output ---
e2e/node_modules/
e2e/.runs/
e2e/test-results/
e2e/playwright-report/

# --- Editor, OS and tooling noise ---
.DS_Store
*.log
coverage/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
